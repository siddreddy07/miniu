# Copy this file to server/.env and fill in the keys:  cp .env.example server/.env
# (The client needs no keys. It calls http://localhost:8000 by default.)

# Required for chat
GROQ_API_KEY=
TAVILY_API_KEY=

# Optional (defaults shown)
PORT=8000
CLIENT_ORIGIN=http://localhost:3000

# Memory (optional: if these are missing or fail, chat still works without memory)
DATABASE_URL=
COHERE_API_KEY=
PINECONE_API_KEY=
# A plain dense index: 1024 dimensions, cosine
PINECONE_INDEX_NAME=
